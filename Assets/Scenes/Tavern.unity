  endingBgmToEndVoiceOverDelay: 20
  subtitle01: "Can you hear them? The clinking of bottles, the laughter, and the
    rhythm of life... \nHow I miss those sounds."
  subtitle02: "This place was once a tavern, where people played the horn and sang
    until the first light of dawn. \nBut those sounds faded long ago."
  subtitle03: "I\u2019m Martha Dawson, the landlady of this tavern. \nI once kept
    this place alive; now I guard its last echoes."
  subtitle04: "You came for the horn, didn\u2019t you? Only a fragment of it remains
    here. \nTake it and return it to where it belongs. \nPerhaps the tavern will
    sing again."
  guidanceSubtitle: "You\u2019re lucky, it has accepted you. \nNow, fit the fragment
    back into place."
  pickupSubtitle: "It\u2019s calling to you. \nPick it up, perhaps something magic
    will happen."
  gardenTransitionSubtitle: Listen! The old ghosts of the tavern are waking up.
  subtitleFadeInSeconds: 0.35
  subtitleFadeOutSeconds: 0.35
